@model CrudMoura.Models.Fruta

<h1>Cadastro de Fruta </h1>

<form asp-action="SalvarFruta" method= "post">
<label asp-for="Nome">Nome da Fruta</label>
<input asp-for="Nome" class="form-Control">
<span asp-validation-for="Nome" class=""></span>

<br>
<label asp-for="Preco">Preco</label>
<input asp-for="Preco" class="form-control">

<br>
<label asp-for="Quantidade">Quantidade em Estoque</label>
<input asp-for="Quantidade" class="form-control">

<br>
<label asp-for="Categoria">Categoria</label>
<input asp-for="Categoria" class="form-control">

<br><br>
<button class="btn btn-primary">Cadastrar Frutas</button>

</form>